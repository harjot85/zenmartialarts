---
import Head from "./Head.astro";

interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const canonicalURL =
  Astro.props.canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
    >
      <slot name="jsonld" slot="jsonld" />
    </Head>
  </head>
  <body class="bg-[var(--color-bg)] text-[var(--color-text)] min-h-dvh">
    <header
      id="site-header"
      class="sticky top-0 z-50 bg-[var(--color-bg)] border-b border-[var(--color-border)]"
    >
      <div
        class="mx-auto max-w-[var(--container-max)] px-[var(--section-padding-x)] flex items-center justify-between h-16 md:h-20"
      >
        <a
          href="/"
          class="[font-family:var(--font-display)] text-3xl tracking-widest uppercase text-[var(--color-text)] hover:opacity-90 transition-opacity"
        >
          ZEN <span class="text-[var(--color-accent)]">MMA</span>
        </a>

        <nav class="hidden md:flex items-center gap-8">
          <a
            href="/programs"
            class="[font-family:var(--font-ui)] text-[15px] uppercase tracking-widest text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
            >Programs</a
          >
          <a
            href="/schedule"
            class="[font-family:var(--font-ui)] text-[15px] uppercase tracking-widest text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
            >Schedule</a
          >
          <a
            href="/about"
            class="[font-family:var(--font-ui)] text-[15px] uppercase tracking-widest text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
            >About</a
          >
        </nav>

        <div class="flex items-center gap-2">
          <a
            href="/#trial"
            class="[font-family:var(--font-ui)] text-sm uppercase tracking-widest bg-[var(--color-accent)] text-[#0a0a0a] px-5 py-2.5 rounded-none font-semibold hover:opacity-90 transition-opacity"
          >
            Free Trial
          </a>

          <button
            id="nav-toggle"
            type="button"
            class="md:hidden flex items-center justify-center w-10 h-10 -mr-2 text-[var(--color-text)]"
            aria-label="Open menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <svg
              class="nav-icon-open w-6 h-6"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
            <svg
              class="nav-icon-close hidden w-6 h-6"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="square"
              aria-hidden="true"
            >
              <line x1="5" y1="5" x2="19" y2="19"></line>
              <line x1="19" y1="5" x2="5" y2="19"></line>
            </svg>
          </button>
        </div>
      </div>

      <nav
        id="mobile-menu"
        class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]"
        aria-label="Primary"
      >
        <a
          href="/programs"
          class="[font-family:var(--font-ui)] block px-[var(--section-padding-x)] py-4 text-lg uppercase tracking-widest text-[var(--color-text-muted)] border-b border-[var(--color-border)] hover:text-[var(--color-text)] transition-colors"
          >Programs</a
        >
        <a
          href="/schedule"
          class="[font-family:var(--font-ui)] block px-[var(--section-padding-x)] py-4 text-lg uppercase tracking-widest text-[var(--color-text-muted)] border-b border-[var(--color-border)] hover:text-[var(--color-text)] transition-colors"
          >Schedule</a
        >
        <a
          href="/about"
          class="[font-family:var(--font-ui)] block px-[var(--section-padding-x)] py-4 text-lg uppercase tracking-widest text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
          >About</a
        >
      </nav>
    </header>

    <script>
      const toggle = document.getElementById("nav-toggle");
      const menu = document.getElementById("mobile-menu");
      const iconOpen = toggle?.querySelector(".nav-icon-open");
      const iconClose = toggle?.querySelector(".nav-icon-close");

      function setMenu(open: boolean) {
        if (!toggle || !menu || !iconOpen || !iconClose) return;
        menu.classList.toggle("hidden", !open);
        iconOpen.classList.toggle("hidden", open);
        iconClose.classList.toggle("hidden", !open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      }

      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        setMenu(!open);
      });

      // Close when a link is tapped.
      menu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenu(false));
      });

      // Close on Escape.
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") setMenu(false);
      });

      // Reset if resized up to desktop, where the menu isn't used.
      window
        .matchMedia("(min-width: 768px)")
        .addEventListener("change", (e) => {
          if (e.matches) setMenu(false);
        });
    </script>

    <main>
      <slot />
    </main>

    <footer></footer>
  </body>
</html>
