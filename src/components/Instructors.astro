---
import CoachList from "./CoachList.astro";
import { coachRoster } from "../lib/coaches";
---

<section class="instructors-section section" id="instructors">
  <div class="wrap">
    <header class="instructors-head">
      <span class="stripe" aria-hidden="true"></span>
      <h2>Meet the coaches</h2>
      <p>The people who&rsquo;ll actually be teaching your class.</p>
    </header>

    <CoachList coaches={coachRoster} compact />

    <p class="instructors-more">
      <a class="btn btn-ghost" href="/about#coaches"
        >Meet the whole team &rarr;</a
      >
    </p>
  </div>
</section>

<style>
  .instructors-section {
    background: var(--color-bg);
  }

  .instructors-head {
    max-width: 62ch;
    margin-bottom: 40px;
  }

  .instructors-head h2 {
    color: var(--color-text);
  }

  .instructors-head p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .instructors-more {
    margin: 20px 0 0;
  }
</style>
