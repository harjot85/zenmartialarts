---
const slides = [
  {
    src: "/images/zen_group_.jpg",
    alt: "The team and members of Zen MMA in Chilliwack, BC",
    position: "60% center",
  },
  {
    src: "/images/team-bjj-wide.jpg",
    alt: "Zen MMA members training Brazilian Jiu-Jitsu on the mats",
    position: "center center",
  },
];
---

<section class="relative overflow-hidden bg-[#1a1400] flex flex-col min-h-svh">
  <!-- Hero image carousel — full-bleed background -->
  <div
    class="hero-carousel absolute inset-0"
    data-hero-carousel
    data-interval="5000"
    role="group"
    aria-roledescription="carousel"
    aria-label="Zen MMA gym photos"
  >
    {
      slides.map((slide, i) => (
        <img
          src={slide.src}
          alt={slide.alt}
          width="1920"
          height="980"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          data-slide
          aria-hidden={i === 0 ? "false" : "true"}
          class:list={[
            "absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-out",
            i === 0 ? "opacity-100" : "opacity-0",
          ]}
          style={`object-position: ${slide.position}`}
        />
      ))
    }
  </div>

  <!-- Diagonal red line pattern overlay -->
  <div
    class="hero-pattern absolute inset-0 opacity-[0.045] pointer-events-none"
  >
  </div>

  <!-- Top-right red glow -->
  <div class="hero-glow absolute pointer-events-none"></div>

  <!-- Bottom-to-top gradient overlay for text legibility -->
  <div class="hero-overlay absolute inset-0 pointer-events-none"></div>

  <!-- Main content — bottom-aligned -->
  <div class="relative z-10 flex-1 flex flex-col justify-end">
    <div
      class="mx-auto w-full max-w-[var(--container-max)] px-[var(--section-padding-x)] pb-10 md:pb-14 flex flex-col gap-6"
    >
      <!-- Badge -->
      <div
        class="self-start flex items-center gap-2 bg-[#0a0a0a]/85 backdrop-blur-sm border border-[#2a2a2a] px-4 py-2"
      >
        <span class="w-2 h-2 shrink-0 rounded-full bg-[var(--color-accent)]"
        ></span>
        <span
          class="[font-family:var(--font-ui)] text-[13px] uppercase tracking-widest text-[var(--color-accent)]"
        >
          Now enrolling · Chilliwack, BC
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="[font-family:var(--font-display)] text-[72px] md:text-[96px] lg:text-[112px] leading-none uppercase text-[var(--color-text)] max-w-3xl"
      >
        FORGE YOUR <span class="text-[var(--color-accent)]">EDGE.</span>
      </h1>

      <!-- Subheading -->
      <p
        class="[font-family:var(--font-body)] text-base md:text-lg text-[#d5d5d5] max-w-xl leading-relaxed"
      >
        World-class Muay Thai, BJJ, and MMA training. All levels welcome — from
        first-timers to competitors.
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
        <a
          href="/#trial"
          class="[font-family:var(--font-ui)] text-sm uppercase tracking-widest font-semibold bg-[var(--color-accent)] text-[#0a0a0a] px-8 py-4 text-center rounded-none hover:opacity-90 transition-opacity w-full sm:w-auto"
        >
          Book Your Free Trial →
        </a>
        <a
          href="/schedule"
          class="[font-family:var(--font-ui)] text-sm uppercase tracking-widest font-semibold bg-transparent text-white border border-[#333] px-8 py-4 text-center rounded-none hover:border-white transition-colors w-full sm:w-auto"
        >
          View Class Schedule
        </a>
      </div>
    </div>
  </div>

  <!-- Carousel controls -->
  <div
    class="relative z-10 mx-auto w-full max-w-[var(--container-max)] px-[var(--section-padding-x)] pb-6"
  >
    <div class="flex items-center gap-3" data-hero-dots>
      {
        slides.map((_, i) => (
          <button
            type="button"
            data-dot
            aria-label={`Show image ${i + 1} of ${slides.length}`}
            aria-current={i === 0 ? "true" : "false"}
            class="hero-dot"
          />
        ))
      }
    </div>
  </div>

  <!-- Stat strip -->
  <div class="relative z-10 border-t border-[#1f1f1f] bg-[#0a0a0a]/80">
    <div
      class="mx-auto max-w-[var(--container-max)] px-[var(--section-padding-x)]"
    >
      <div class="grid grid-cols-3 divide-x divide-[#1f1f1f]">
        <div class="flex flex-col items-center py-6 gap-1">
          <span
            class="[font-family:var(--font-display)] text-4xl text-[var(--color-accent)] leading-none"
            >4</span
          >
          <span
            class="[font-family:var(--font-ui)] text-[10px] md:text-xs uppercase tracking-widest text-[var(--color-text-muted)]"
            >Years Open</span
          >
        </div>

        <div class="flex flex-col items-center py-6 gap-1">
          <!-- TODO: Replace with real member count -->
          <span
            class="[font-family:var(--font-display)] text-4xl text-[var(--color-accent)] leading-none"
            >—</span
          >
          <span
            class="[font-family:var(--font-ui)] text-[10px] md:text-xs uppercase tracking-widest text-[var(--color-text-muted)]"
            >Members</span
          >
        </div>

        <div class="flex flex-col items-center py-6 gap-1">
          <!-- TODO: Replace with real coach count -->
          <span
            class="[font-family:var(--font-display)] text-4xl text-[var(--color-accent)] leading-none"
            >6</span
          >
          <span
            class="[font-family:var(--font-ui)] text-[10px] md:text-xs uppercase tracking-widest text-[var(--color-text-muted)]"
            >Coaches</span
          >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-pattern {
    background-image: repeating-linear-gradient(
      45deg,
      #cc1c1c 0,
      #cc1c1c 1px,
      transparent 0,
      transparent 50%
    );
    background-size: 22px 22px;
  }

  .hero-glow {
    top: -15%;
    right: -5%;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(204, 28, 28, 0.12) 0%,
      transparent 70%
    );
  }

  .hero-overlay {
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.97) 0%,
      rgba(10, 10, 10, 0.75) 35%,
      rgba(10, 10, 10, 0.2) 70%,
      rgba(10, 10, 10, 0.05) 100%
    );
  }
  .hero-dot {
    width: 32px;
    height: 3px;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      width 0.3s ease;
  }

  .hero-dot:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  .hero-dot[aria-current="true"] {
    width: 48px;
    background: var(--color-accent);
  }

  .hero-dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .hero-carousel {
    touch-action: pan-y;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel [data-slide] {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  function initHeroCarousel(root: HTMLElement) {
    const slides = Array.from(
      root.querySelectorAll<HTMLImageElement>("[data-slide]"),
    );
    if (slides.length < 2) return;

    const section = root.closest("section");
    const dots = Array.from(
      section?.querySelectorAll<HTMLButtonElement>("[data-dot]") ?? [],
    );
    const interval = Number(root.dataset.interval ?? 5000);

    let current = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle("opacity-100", active);
        slide.classList.toggle("opacity-0", !active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-current", i === current ? "true" : "false"),
      );
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = () => {
      stop();
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => show(current + 1), interval);
    };

    const goTo = (next: number) => {
      show(next);
      start();
    };

    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    // Swipe / drag
    let startX = 0;
    let startY = 0;
    let tracking = false;

    const onDown = (x: number, y: number) => {
      startX = x;
      startY = y;
      tracking = true;
    };

    const onUp = (x: number, y: number) => {
      if (!tracking) return;
      tracking = false;
      const dx = x - startX;
      const dy = y - startY;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      goTo(current + (dx < 0 ? 1 : -1));
    };

    const swipeTarget = section ?? root;

    swipeTarget.addEventListener(
      "touchstart",
      (e) => {
        const t = (e as TouchEvent).changedTouches[0];
        onDown(t.clientX, t.clientY);
      },
      { passive: true },
    );

    swipeTarget.addEventListener(
      "touchend",
      (e) => {
        const t = (e as TouchEvent).changedTouches[0];
        onUp(t.clientX, t.clientY);
      },
      { passive: true },
    );

    swipeTarget.addEventListener("mousedown", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a, button")) return;
      onDown((e as MouseEvent).clientX, (e as MouseEvent).clientY);
    });

    swipeTarget.addEventListener("mouseup", (e) =>
      onUp((e as MouseEvent).clientX, (e as MouseEvent).clientY),
    );

    swipeTarget.addEventListener("mouseleave", () => {
      tracking = false;
    });

    // Pause when off-screen or tab hidden
    document.addEventListener("visibilitychange", () =>
      document.hidden ? stop() : start(),
    );

    if ("IntersectionObserver" in window && section) {
      new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? start() : stop()),
        { threshold: 0.1 },
      ).observe(section);
    } else {
      start();
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-hero-carousel]")
    .forEach(initHeroCarousel);
</script>
