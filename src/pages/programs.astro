---
import Layout from "../layouts/Layout.astro";
import ProgramCard from "../components/ProgramCard.astro";
import PageHero from "../components/PageHero.astro";
import ClosingBand from "../components/ClosingBand.astro";
import { programs } from "../lib/programs";
---

<Layout
  title="Martial Arts Programs in Chilliwack, BC — Zen Martial Arts"
  description="BJJ, Muay Thai, kickboxing, boxing, wrestling, kids martial arts and women's self-defense in Chilliwack, BC. Explore every program at Zen Martial Arts."
>
  <PageHero
    title="Our programs"
    lede="Six disciplines under one roof in Chilliwack. Pick one to start, or ask a coach which fits your goals best."
  />

  <section class="programs-section section">
    <div class="programs-inner wrap">
      <ul class="programs-grid" role="list">
        {
          programs.map((program) => (
            <ProgramCard
              title={program.name}
              text={program.description}
              href={program.href}
              cta={program.cta}
              days={program.days}
              headingLevel={2}
              size="large"
            />
          ))
        }
      </ul>
    </div>
  </section>

  <ClosingBand
    heading="Not sure which one fits?"
    text="Come try a class — your first one is free, and a coach can point you toward the right program in person."
    secondary={{ label: "See the class schedule", href: "/schedule" }}
  />
</Layout>

<style>
  .programs-section {
    background: var(--color-bg);
  }

  .programs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 700px) {
    .programs-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
