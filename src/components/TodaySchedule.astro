---
import {
  days,
  dayIndexMap,
  formatRange,
  audienceLabel,
  parseMinutes,
  disciplineOf,
  levelOf,
} from "../lib/schedule";

// Today's view combines adults + kids into one chronological list.
const combined = days.map((day) => ({
  ...day,
  classes: [...day.classes].sort(
    (a, b) => parseMinutes(a.start) - parseMinutes(b.start),
  ),
}));
---

<section class="today-section">
  <div class="today-inner">
    <div class="today-header">
      <span class="today-label">Today at Zen MMA</span>
      <h2 class="today-title">TODAY'S CLASSES</h2>
      <p class="today-date" id="today-date">&nbsp;</p>
    </div>

    <div class="day-panels">
      {
        combined.map((day) => (
          <div class="day-panel" data-day={dayIndexMap[day.day]}>
            {day.classes.length > 0 ? (
              <div class="class-cards">
                {day.classes.map((cls) => (
                  <div
                    class="class-card"
                    data-category={cls.category}
                    data-discipline={disciplineOf(cls)}
                    data-level={levelOf(cls)}
                  >
                    <div class="class-time">
                      {formatRange(cls.start, cls.end)}
                    </div>
                    <div class="class-body">
                      <div class="class-name">{cls.name}</div>
                      {cls.detail && (
                        <div class="class-detail">{cls.detail}</div>
                      )}
                    </div>
                    <div class="class-category-badge">
                      {audienceLabel(cls.category)}
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <div class="no-classes">
                <p>Closed today. See you tomorrow!</p>
                <p>
                  Contact us for private training:{" "}
                  <a href="tel:+17788356590" class="no-classes-phone">
                    778-835-6590
                  </a>
                </p>
              </div>
            )}
          </div>
        ))
      }
    </div>

    <div class="today-footer">
      <a href="/schedule" class="today-link">View Full Schedule →</a>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var dayIndex = new Date().getDay();

    var panel = document.querySelector(
      '.day-panel[data-day="' + dayIndex + '"]',
    );
    if (panel) {
      panel.style.display = "flex";
      panel.style.flexDirection = "column";
    }

    var dateEl = document.getElementById("today-date");
    if (dateEl) {
      var options = { weekday: "long", month: "long", day: "numeric" };
      dateEl.textContent = new Date().toLocaleDateString("en-CA", options);
    }
  });
</script>

<style>
  .today-section {
    background: #0a0a0a;
    padding: 48px 24px;
  }

  .today-inner {
    max-width: 680px;
    margin: 0 auto;
  }

  .today-header {
    margin-bottom: 32px;
  }

  .today-label {
    display: block;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .today-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: 44px;
    color: #f5f5f5;
    margin: 0 0 6px;
    line-height: 1;
  }

  .today-date {
    font-family: "Barlow", sans-serif;
    font-size: 14px;
    color: var(--color-secondary);
    margin: 0;
    line-height: 1.4;
  }

  [data-discipline="bjj"] {
    --std: var(--discipline-bjj);
    --adv: var(--discipline-bjj-adv);
  }
  [data-discipline="wrestling"] {
    --std: var(--discipline-wrestling);
    --adv: var(--discipline-wrestling-adv);
  }
  [data-discipline="striking"] {
    --std: var(--discipline-striking);
    --adv: var(--discipline-striking-adv);
  }
  [data-discipline="boxing"] {
    --std: var(--discipline-boxing);
    --adv: var(--discipline-boxing-adv);
  }
  [data-discipline="mma"] {
    --std: var(--discipline-mma);
    --adv: var(--discipline-mma-adv);
  }
  [data-discipline="specialty"] {
    --std: var(--discipline-specialty);
    --adv: var(--discipline-specialty-adv);
  }
  [data-discipline="openmat"] {
    --std: var(--discipline-openmat);
    --adv: var(--discipline-openmat-adv);
  }
  [data-discipline] {
    --hue: var(--std);
  }
  [data-discipline][data-level="advanced"] {
    --hue: var(--adv);
  }

  .day-panel {
    display: none;
  }

  .class-cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .class-card {
    background: #171717;
    border-left: 3px solid var(--hue);
    padding: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 0;
    gap: 14px;
  }

  .class-time {
    font-family: "Bebas Neue", sans-serif;
    font-size: 16.5px;
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
    min-width: 116px;
    line-height: 1.15;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }

  .class-body {
    flex: 1;
    min-width: 0;
  }

  .class-name {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 17px;
    font-weight: 700;
    text-transform: uppercase;
    color: #f5f5f5;
    line-height: 1.2;
  }

  .class-detail {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 13px;
    text-transform: uppercase;
    color: var(--color-secondary);
    line-height: 1.3;
  }

  .class-category-badge {
    background: #1a1a1a;
    border: 1px solid #333;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--color-secondary);
    padding: 4px 10px;
    border-radius: 0;
    flex-shrink: 0;
    line-height: 1.4;
    white-space: nowrap;
  }

  .no-classes {
    text-align: center;
    padding: 32px 0;
    font-family: "Barlow", sans-serif;
    font-size: 15px;
    color: #666;
    line-height: 1.7;
  }

  .no-classes p {
    margin: 0;
  }

  .no-classes-phone {
    color: var(--color-accent);
    text-decoration: none;
  }

  .today-footer {
    margin-top: 24px;
    text-align: center;
  }

  .today-link {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .today-link:hover {
    opacity: 0.8;
  }

  @media (max-width: 520px) {
    .class-card {
      flex-wrap: wrap;
    }
    .class-time {
      min-width: 0;
      width: 100%;
    }
  }
</style>
