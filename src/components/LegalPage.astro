---
// Shell for /terms and /privacy (mockup terms.html / privacy.html): short
// hero with a "Last updated" lede, then an article of numbered h2 sections.
// Both pages are drafts pending legal review, so they're always noindex.
import Layout from "../layouts/Layout.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  /** Hero lede, starting with the "Last updated" date. */
  lede: string;
}

const { title, description, heading, lede } = Astro.props;
---

<Layout title={title} description={description} noindex>
  <section class="section legal-hero">
    <div class="wrap">
      <span class="stripe" aria-hidden="true"></span>
      <h1>{heading}</h1>
      <p class="lede">{lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <article class="legal-article">
        <slot />
      </article>
    </div>
  </section>
</Layout>

<style>
  .legal-hero {
    padding-block: clamp(56px, 10vw, 88px) 24px;
  }

  .lede {
    max-width: 56ch;
    margin: 0;
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  /* Article body comes in through the slot, so these reach into it. */
  .legal-article :global(p) {
    max-width: 68ch;
    margin: 0 0 1em;
  }

  .legal-article :global(h2) {
    margin-top: 1.4em;
  }

  .legal-article :global(a) {
    color: var(--color-accent-bright);
  }

  .legal-article :global(a:hover) {
    color: var(--color-text);
  }

  .legal-article :global(.legal-callout) {
    padding: 16px 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.92rem;
    color: var(--color-text-muted);
  }
</style>
