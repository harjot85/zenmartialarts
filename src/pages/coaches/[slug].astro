---
import Layout from "../../layouts/Layout.astro";
import CoachProfile from "../../components/CoachProfile.astro";
import PageHero from "../../components/PageHero.astro";
import ClosingBand from "../../components/ClosingBand.astro";
import { coaches, getDisciplines } from "../../lib/coaches";

export function getStaticPaths() {
  return coaches.map((coach) => ({
    params: { slug: coach.slug },
    props: { coach },
  }));
}

const { coach } = Astro.props;
const disciplines = getDisciplines(coach.scheduleName);
---

<Layout
  title={`${coach.displayName} — ${coach.role} at Zen Martial Arts, Chilliwack BC`}
  description={coach.bio}
>
  <PageHero
    title={`Meet ${coach.displayName}`}
    lede={`${coach.role} at Zen Martial Arts & Fitness in Chilliwack, BC.`}
    breadcrumb={[
      { label: "Home", href: "/" },
      { label: "About", href: "/about" },
      { label: coach.displayName },
    ]}
  />

  <section class="coach-page section">
    <div class="coach-page-inner wrap">
      <CoachProfile coach={coach} />

      {
        disciplines.length > 0 && (
          <section class="teaches" aria-labelledby="teaches-title">
            <span class="stripe" aria-hidden="true" />
            <h2 id="teaches-title" class="teaches-title">
              Classes {coach.displayName} teaches
            </h2>
            <ul class="teaches-list" role="list">
              {disciplines.map((d) => (
                <li class="teaches-item">{d}</li>
              ))}
            </ul>
            <a href="/schedule" class="coach-btn coach-btn--ghost">
              View class schedule
            </a>
          </section>
        )
      }

      {
        coach.archive && coach.archive.length > 0 && (
          <section class="archive" aria-labelledby="archive-title">
            <span class="stripe steel" aria-hidden="true" />
            <h2 id="archive-title" class="archive-title">
              From the archives
            </h2>
            {coach.archive.map((moment) => (
              <figure class="moment">
                <img
                  class="moment-img"
                  src={moment.src}
                  alt={moment.alt}
                  width={moment.width}
                  height={moment.height}
                  loading="lazy"
                />
                <figcaption class="moment-caption">
                  <span class="moment-year">{moment.year}</span>
                  <span class="moment-title">{moment.title}</span>
                  <p class="moment-text">{moment.caption}</p>
                </figcaption>
              </figure>
            ))}
          </section>
        )
      }
    </div>
  </section>

  <ClosingBand
    heading={`Train with ${coach.displayName}`}
    text="Your first week is free — the best way to know if a coach is right for you is to take their class."
    secondary={{ label: "About the gym", href: "/about" }}
  />
</Layout>

<style>
  .coach-page {
    background: var(--color-bg);
  }

  .teaches {
    margin-top: 48px;
  }

  .teaches-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--color-text);
    line-height: 1.08;
    margin: 0 0 20px;
  }

  .teaches-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }

  .teaches-item {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    padding: 12px 18px;
  }

  .archive {
    margin-top: 48px;
  }

  .archive-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    color: var(--color-text);
    line-height: 1.08;
    margin: 0 0 20px;
  }

  .moment {
    margin: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .moment + .moment {
    margin-top: 20px;
  }

  .moment-img {
    display: block;
    width: 100%;
    height: auto;
    /* An old, low-resolution photo — keep the browser from over-smoothing it. */
    image-rendering: auto;
    filter: saturate(0.85) contrast(1.05);
  }

  .moment-caption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px;
    border-top: 3px solid var(--color-accent);
  }

  .moment-year {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .moment-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 5vw, 28px);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.08;
  }

  .moment-text {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 6px 0 0;
    max-width: 60ch;
  }

  .coach-btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    padding: 16px 32px;
    text-align: center;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .coach-btn:hover {
    opacity: 0.85;
  }

  .coach-btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .coach-btn--ghost:hover {
    border-color: var(--color-text-muted);
    opacity: 1;
  }
</style>
