---
import type { Coach } from "../lib/coaches";

interface Props {
  coaches: Coach[];
  /** Homepage teaser: no bios, just a "Read X's story" link to the full one. */
  compact?: boolean;
}

const { coaches, compact = false } = Astro.props;

// Anchor id for a coach's row on /about, e.g. "coach-ashley-watkins".
function anchorId(coach: Coach): string {
  const slug = coach.name
    .replace(/"[^"]*"/g, "") // drop nicknames
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "") // Peña → Pena
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, "-");
  return `coach-${slug}`;
}

// Coaches with a profile page go there; everyone else to their /about row.
function storyHref(coach: Coach): string {
  return coach.profileSlug
    ? `/coaches/${coach.profileSlug}`
    : `/about#${anchorId(coach)}`;
}

const firstName = (coach: Coach) => coach.name.split(" ")[0];
---

<ul class:list={["coach-list", { "is-compact": compact }]} role="list">
  {
    coaches.map((coach) => (
      <li class="coach-row" id={compact ? undefined : anchorId(coach)}>
        <div class:list={["coach-row-photo", { "is-empty": !coach.photo }]}>
          {coach.photo ? (
            <img
              src={coach.photo.src}
              alt={coach.photo.alt}
              width={coach.photo.width}
              height={coach.photo.height}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <>
              <svg
                class="coach-row-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
              >
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
              </svg>
              <span class="coach-row-photo-label">Photo coming soon</span>
            </>
          )}
        </div>
        <div class="coach-row-body">
          <h3 class="coach-row-name">
            {coach.profileSlug ? (
              <a href={`/coaches/${coach.profileSlug}`}>{coach.name}</a>
            ) : (
              coach.name
            )}
          </h3>
          <span class="coach-row-role">{coach.role}</span>
          {!compact && coach.bio && <p class="coach-row-bio">{coach.bio}</p>}
          {compact && coach.bio && (
            <a class="coach-row-story" href={storyHref(coach)}>
              Read {firstName(coach)}&rsquo;s story{" "}
              <span aria-hidden="true">&rarr;</span>
            </a>
          )}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .coach-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .coach-row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 24px;
    padding: 28px 0;
    border-top: 1px solid var(--color-border);
  }

  /* Clear the sticky header when jumped to from a "Read X's story" link. */
  .coach-row {
    scroll-margin-top: 96px;
  }

  .coach-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .coach-row-photo {
    width: 160px;
    height: 160px;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .coach-row-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .coach-row-photo.is-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    text-align: center;
    /* Faint lift that reads on ink, soft ink and paper alike. */
    background: color-mix(in srgb, currentColor 4%, transparent);
    border-style: dashed;
  }

  .coach-row-icon {
    width: 44px;
    height: 44px;
    opacity: 0.18;
  }

  .coach-row-photo-label {
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  .coach-row-name {
    margin: 0 0 4px;
  }

  .coach-row-name a {
    text-decoration: underline;
    text-decoration-color: var(--color-accent-border);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color 0.15s,
      text-decoration-color 0.15s;
  }

  .coach-row-name a:hover {
    color: var(--color-accent-bright);
    text-decoration-color: currentColor;
  }

  .coach-row-role {
    display: block;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--color-accent-bright);
    margin-bottom: 10px;
  }

  .coach-row-bio {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 62ch;
  }

  .coach-row-story {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-border);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
    transition:
      color 0.15s,
      text-decoration-color 0.15s;
  }

  .coach-row-story:hover {
    color: var(--color-accent-bright);
    text-decoration-color: currentColor;
  }

  /* Compact (homepage): two columns of smaller rows, no bios. */
  .coach-list.is-compact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    column-gap: 40px;
    border-bottom: 1px solid var(--color-border);
  }

  .is-compact .coach-row {
    grid-template-columns: 96px 1fr;
    gap: 20px;
    padding: 20px 0;
    align-items: center;
  }

  .is-compact .coach-row:last-child {
    border-bottom: 0;
  }

  .is-compact .coach-row-photo {
    width: 96px;
    height: 96px;
  }

  .is-compact .coach-row-photo.is-empty {
    padding: 6px;
    gap: 4px;
  }

  .is-compact .coach-row-icon {
    width: 28px;
    height: 28px;
  }

  .is-compact .coach-row-photo-label {
    font-size: 0.75rem; /* 12px floor */
  }

  .is-compact .coach-row-role {
    margin-bottom: 6px;
  }

  /* Gold-bright is too light on paper — use the deep gold there. */
  :global(.on-paper) .coach-row-role,
  :global(.on-paper) .coach-row-name a:hover,
  :global(.on-paper) .coach-row-story:hover {
    color: var(--color-accent-deep);
  }

  @media (max-width: 560px) {
    .coach-row {
      grid-template-columns: 96px 1fr;
    }

    .coach-row-photo {
      width: 96px;
      height: 96px;
    }

    .coach-row-photo.is-empty {
      padding: 6px;
      gap: 4px;
    }

    .coach-row-icon {
      width: 28px;
      height: 28px;
    }

    .coach-row-photo-label {
      font-size: 0.75rem; /* 12px floor */
    }
  }
</style>
