---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ClosingBand from "../components/ClosingBand.astro";
import CoachProfile from "../components/CoachProfile.astro";
import CoachList from "../components/CoachList.astro";
import { coachRoster, getCoachByScheduleName } from "../lib/coaches";

const eric = getCoachByScheduleName("Eric A.")!;
// Eric already has the full profile card above; list everyone else.
const otherCoaches = coachRoster.filter((c) => c.profileSlug !== eric.slug);
---

<Layout
  title="About Zen Martial Arts — Coach Eric & Our Gym in Chilliwack, BC"
  description="Meet Coach Eric, a BJJ Black Belt under Marcus Soares (Carlson Gracie), and learn about Zen Martial Arts & Fitness — 4 years of BJJ, Muay Thai, and MMA in Chilliwack, BC."
>
  <PageHero
    title="About Zen Martial Arts"
    lede="Four years in Chilliwack, built around one idea: real martial arts training shouldn't require you to already be an athlete. It's how you become one."
  />

  <section class="section" aria-labelledby="about-story-title">
    <div class="wrap">
      <header class="about-header">
        <span class="stripe steel" aria-hidden="true"></span>
        <h2 id="about-story-title">Our story</h2>
        <p class="about-intro">
          Zen Martial Arts &amp; Fitness has proudly served the Chilliwack
          community for 4 years, offering high-quality Brazilian Jiu-Jitsu,
          wrestling, Muay Thai, boxing, and MMA training for all ages and
          experience levels.
        </p>
        <p class="about-intro">
          Whether you&rsquo;re a complete beginner or an experienced martial
          artist, Coach Eric and the Zen team are here to help you grow in a
          supportive, family-oriented environment.
        </p>
      </header>
    </div>
  </section>

  <section class="about-section section">
    <div class="about-inner wrap">
      <div class="coach-slot">
        <CoachProfile coach={eric} />
      </div>
    </div>
  </section>

  <section
    class="about-coaches section on-soft"
    id="coaches"
    aria-labelledby="about-coaches-title"
  >
    <div class="wrap">
      <header class="about-coaches-head">
        <span class="stripe" aria-hidden="true"></span>
        <h2 id="about-coaches-title">The rest of the team</h2>
        <p>The people who&rsquo;ll actually be teaching your class.</p>
      </header>

      <CoachList coaches={otherCoaches} />
    </div>
  </section>

  <ClosingBand
    heading="Come meet us in person"
    text="Your first week is free — the best way to know if a gym is right for you is to train in it."
  />
</Layout>

<style>
  .about-section {
    background: var(--color-bg);
  }

  .about-header {
    max-width: 62ch;
  }

  .about-header h2 {
    margin-bottom: 0;
  }

  .about-intro {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 16px 0 0;
  }

  .coach-slot {
    margin-bottom: 0;
  }

  .about-coaches-head {
    max-width: 62ch;
    margin-bottom: 40px;
  }

  .about-coaches-head p {
    color: var(--color-text-muted);
    margin: 0;
  }
</style>
