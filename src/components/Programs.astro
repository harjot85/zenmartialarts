---
import { programs } from "../lib/programs";

// The full 7-card list feels long on a phone, so on mobile we surface only the
// four headline disciplines; the rest are revealed at the grid breakpoint and
// via the "View All Programs" link. All 7 stay in the HTML (desktop + SEO).
const mobileKeys = new Set<string>([
  "bjj-nogi",
  "muay-thai",
  "boxing",
  "wrestling",
]);
---

<section class="programs-section" id="programs">
  <div class="programs-inner">
    <div class="programs-header">
      <span class="programs-label">What we teach</span>
      <h2 class="programs-title">OUR PROGRAMS</h2>
    </div>

    <ul class="programs-grid" role="list">
      {
        programs.map((program) => (
          <li
            class:list={[
              "program-card",
              { "program-card--desktop-only": !mobileKeys.has(program.key) },
            ]}
          >
            <span class="program-card__accent" aria-hidden="true" />
            <h3 class="program-card__name">{program.name}</h3>
            <p class="program-card__desc">{program.short}</p>
          </li>
        ))
      }
    </ul>

    <div class="programs-footer">
      <a href="/programs" class="programs-link">View All Programs →</a>
    </div>
  </div>
</section>

<style>
  .programs-section {
    background: #0a0a0a;
    padding: 48px 24px;
  }

  .programs-inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .programs-header {
    margin-bottom: 32px;
  }

  .programs-label {
    display: block;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .programs-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: 44px;
    color: #f5f5f5;
    margin: 0;
    line-height: 1;
  }

  .programs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .program-card {
    position: relative;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 24px 22px;
    overflow: hidden;
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  /* Gold accent bar — highlights the program at a glance. */
  .program-card__accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--color-accent);
  }

  .program-card:hover {
    border-color: var(--color-accent-border);
    transform: translateY(-2px);
  }

  .program-card__name {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-accent);
    line-height: 1.15;
    margin: 0 0 10px;
  }

  .program-card__desc {
    font-family: "Barlow", sans-serif;
    font-size: 14px;
    color: var(--color-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .programs-footer {
    margin-top: 28px;
    text-align: center;
  }

  .programs-link {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .programs-link:hover {
    opacity: 0.8;
  }

  /* Trim the list to four headline cards on mobile. */
  .program-card--desktop-only {
    display: none;
  }

  @media (min-width: 640px) {
    .programs-grid {
      grid-template-columns: 1fr 1fr;
    }

    .program-card--desktop-only {
      display: block;
    }
  }
</style>
