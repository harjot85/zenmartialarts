---
import ProgramCard from "./ProgramCard.astro";
import { programs } from "../lib/programs";

// The full list feels long on a phone, so on mobile we surface only the four
// headline disciplines; the rest are revealed at the grid breakpoint and via
// the "View all programs" link. All six stay in the HTML (desktop + SEO).
const mobileSlugs = new Set<string>([
  "bjj",
  "muay-thai-kickboxing",
  "boxing",
  "wrestling",
]);
---

<section class="programs-section section" id="programs">
  <div class="programs-inner wrap">
    <div class="programs-header">
      <span class="stripe" aria-hidden="true"></span>
      <h2 class="programs-title">Our programs</h2>
      <p class="programs-intro">
        Six disciplines under one roof, so your training can grow with you.
      </p>
    </div>

    <ul class="programs-grid" role="list">
      {
        programs.map((program) => (
          <ProgramCard
            title={program.name}
            text={program.short}
            href={program.href}
            cta={program.cta}
            class={
              mobileSlugs.has(program.slug)
                ? undefined
                : "program-card--desktop-only"
            }
          />
        ))
      }
    </ul>

    <div class="programs-footer">
      <a href="/programs" class="programs-link">View all programs →</a>
    </div>
  </div>
</section>

<style>
  .programs-section {
    background: var(--color-bg);
  }

  .programs-header {
    max-width: 62ch;
    margin-bottom: 40px;
  }

  .programs-title {
    color: var(--color-text);
    margin: 0;
  }

  .programs-intro {
    max-width: 62ch;
    margin: 12px 0 0;
    color: var(--color-text-muted);
  }

  .programs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .programs-footer {
    margin-top: 28px;
    text-align: center;
  }

  .programs-link {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .programs-link:hover {
    color: var(--color-accent-bright);
  }

  /* Trim the list to four headline cards on mobile. */
  .programs-grid :global(.program-card--desktop-only) {
    display: none;
  }

  @media (min-width: 640px) {
    .programs-grid {
      grid-template-columns: 1fr 1fr;
    }

    .programs-grid :global(.program-card--desktop-only) {
      display: flex;
    }
  }
</style>
