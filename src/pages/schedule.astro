---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ScheduleGrid from "../components/ScheduleGrid.astro";
import ClosingBand from "../components/ClosingBand.astro";
import { effective, gymHours } from "../lib/schedule";

// schedule.json separates the two hour ranges with " · "; the lede reads as
// a sentence, so join them with a comma instead.
const hours = gymHours.replace(/\s*·\s*/g, ", ");
---

<Layout
  title="Class Schedule | Zen Martial Arts — Chilliwack, BC"
  description="View the full weekly class schedule at Zen Martial Arts in Chilliwack, BC. Muay Thai, BJJ, Kickboxing, Kids classes and more."
  canonicalURL="https://zenmartialarts.ca/schedule"
>
  <PageHero title="Class schedule">
    Effective {effective}. Gym hours: {hours}. No classes on holidays — check
    social media for open mat times, and confirm live times at
    <a
      href="https://www.instagram.com/zenmartialartsandfitness/"
      target="_blank"
      rel="noopener">@zenmartialartsandfitness</a
    > since the schedule is subject to change.
  </PageHero>

  <ScheduleGrid />

  <ClosingBand
    heading="Bring your family in for a free class"
    text="See the schedule that fits your week, then come try it."
  />
</Layout>
