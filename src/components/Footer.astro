---
import { gymHours } from "../lib/schedule";
import { programs } from "../lib/programs";

const programLinks = programs.map((p) => ({ href: p.href, label: p.name }));

const infoLinks = [
  { href: "/pricing", label: "Pricing" },
  { href: "/schedule", label: "Schedule" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
  { href: "/terms", label: "Terms of Service" },
  { href: "/privacy", label: "Privacy Policy" },
];

const legalLinks = infoLinks.slice(-2);

// schedule.json stores hours as one "·"-separated string; show one line each.
const hoursLines = gymHours.split("·").map((line) => line.trim());

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="foot-grid">
      <div>
        <img
          src="/images/zen-logo.jpg"
          alt=""
          width="76"
          height="76"
          loading="lazy"
          class="footer-logo"
        />
        <h2>Zen Martial Arts &amp; Fitness</h2>
        <p>
          MMA, BJJ, Muay Thai, kickboxing, boxing and wrestling in Chilliwack,
          BC.
        </p>
        <a
          href="https://www.instagram.com/zenmartialartsandfitness/"
          target="_blank"
          rel="noopener noreferrer"
          >Instagram <span aria-hidden="true">→</span></a
        >
      </div>

      <nav aria-labelledby="footer-programs">
        <h2 id="footer-programs">Programs</h2>
        {programLinks.map((p) => <a href={p.href}>{p.label}</a>)}
      </nav>

      <nav aria-labelledby="footer-info">
        <h2 id="footer-info">Info</h2>
        {infoLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <div>
        <h2>Visit</h2>
        <address>
          <p>48640 Yale Rd<br />Chilliwack, BC V4Z 0B1</p>
          <a href="tel:+17788356590">778-835-6590</a>
          {/* TODO: confirm real email */}
          <a href="mailto:info@zenmartialarts.ca">info@zenmartialarts.ca</a>
        </address>
        <p>
          {
            hoursLines.map((line, i) => (
              <>
                {i > 0 && <br />}
                {line}
              </>
            ))
          }
        </p>
        <div class="map-embed">
          <iframe
            src="https://www.google.com/maps?q=48640+Yale+Rd,+Chilliwack,+BC+V4Z+0B1&output=embed"
            loading="lazy"
            title="Google Map showing Zen Martial Arts & Fitness at 48640 Yale Rd, Chilliwack, BC"
          ></iframe>
        </div>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© {year} Zen Martial Arts &amp; Fitness. All rights reserved.</span>
      <span class="foot-legal">
        {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-surface);
    padding: 56px 0 28px;
    font-family: var(--font-body);
  }

  .footer-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding-x);
  }

  .foot-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.4fr;
    gap: 32px;
    margin-bottom: 40px;
  }

  @media (max-width: 800px) {
    .foot-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .foot-grid h2 {
    margin: 0 0 14px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1.3;
    text-transform: none;
    color: var(--color-text-muted);
  }

  .foot-grid a,
  .foot-grid p {
    display: block;
    margin: 0 0 8px;
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text);
    text-decoration: none;
  }

  .foot-grid a:hover {
    color: var(--color-accent-bright);
  }

  /* Phones: 40px tap targets (links were 24px tall). Padding replaces
     the 8px gap, so the list only grows by 8px per link. */
  @media (max-width: 800px) {
    .foot-grid a {
      padding-block: 8px;
      margin-bottom: 0;
    }

    .foot-legal a {
      padding-block: 8px;
    }
  }

  .foot-grid address {
    font-style: normal;
  }

  .footer-logo {
    width: 76px;
    height: 76px;
    margin-bottom: 14px;
    border-radius: 50%;
  }

  .map-embed iframe {
    display: block;
    width: 100%;
    height: 220px;
    border: 1px solid var(--color-border);
    filter: grayscale(0.3) invert(0.92) contrast(0.9);
  }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid var(--color-border);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .foot-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .foot-legal a {
    color: var(--color-text);
    text-decoration: none;
  }

  .foot-legal a:hover {
    color: var(--color-accent-bright);
  }
</style>
