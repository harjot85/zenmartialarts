---
const slides = [
  {
    src: "/images/zen_group_.jpg",
    alt: "The team and members of Zen Martial Arts in Chilliwack, BC",
    position: "60% center",
  },
  {
    src: "/images/team-bjj-wide.jpg",
    alt: "Zen Martial Arts members training Brazilian Jiu-Jitsu on the mats",
    position: "center center",
  },
];

const stats = [
  { value: "4", label: "Years open in Chilliwack" },
  { value: "6", label: "Coaches on staff" },
  { value: "0", label: "Contracts required" },
  { value: "1", label: "Week free trial" },
];
---

<section class="relative overflow-hidden bg-bg flex flex-col min-h-svh">
  <!-- Hero image carousel — full-bleed background -->
  <div
    class="hero-carousel absolute inset-0"
    data-hero-carousel
    data-interval="5000"
    role="group"
    aria-roledescription="carousel"
    aria-label="Zen Martial Arts gym photos"
  >
    {
      slides.map((slide, i) => (
        <img
          src={slide.src}
          alt={slide.alt}
          width="1920"
          height="980"
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          data-slide
          aria-hidden={i === 0 ? "false" : "true"}
          class:list={[
            "absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ease-out",
            i === 0 ? "opacity-100" : "opacity-0",
          ]}
          style={`object-position: ${slide.position}`}
        />
      ))
    }
  </div>

  <!-- Diagonal gold line pattern overlay -->
  <div
    class="hero-pattern absolute inset-0 opacity-[0.045] pointer-events-none"
  >
  </div>

  <!-- Top-right gold glow -->
  <div class="hero-glow absolute pointer-events-none"></div>

  <!-- Bottom-to-top gradient overlay for text legibility -->
  <div class="hero-overlay absolute inset-0 pointer-events-none"></div>

  <!-- Main content — bottom-aligned -->
  <div class="relative z-10 flex-1 flex flex-col justify-end">
    <div
      class="mx-auto w-full max-w-[var(--container-max)] px-[var(--section-padding-x)] pb-10 md:pb-14 flex flex-col gap-6"
    >
      <!-- Badge -->
      <div
        class="self-start flex items-center gap-2 bg-bg/85 backdrop-blur-sm border border-border px-4 py-2"
      >
        <span class="w-2 h-2 shrink-0 rounded-full bg-[var(--color-accent)]"
        ></span>
        <span class="font-body text-sm font-medium text-[var(--color-accent)]">
          Now enrolling · Chilliwack, BC
        </span>
      </div>

      <!-- Headline -->
      <h1
        class="font-display font-bold text-[56px] sm:text-[72px] md:text-[88px] lg:text-[104px] leading-[1.02] tracking-[0.01em] text-[var(--color-text)] max-w-3xl mb-0"
      >
        Forge your <span class="text-[var(--color-accent)]">edge.</span>
      </h1>

      <!-- Subheading -->
      <p
        class="font-body text-base md:text-lg text-text/85 max-w-xl leading-relaxed"
      >
        World-class Muay Thai, BJJ, boxing and wrestling — taught by people who
        remember what your first class felt like. Complete beginners are not
        just welcome here, they're most of the room.
      </p>

      <!-- Buttons -->
      <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
        <a
          href="/#trial"
          class="font-body text-base font-semibold bg-[var(--color-accent)] text-bg px-8 py-4 text-center rounded-none hover:opacity-90 transition-opacity w-full sm:w-auto"
        >
          Book your free trial
        </a>
        <a
          href="/#start-here"
          class="font-body text-base font-semibold bg-transparent text-text border border-border px-8 py-4 text-center rounded-none hover:border-text transition-colors w-full sm:w-auto"
        >
          New to martial arts? Start here
        </a>
      </div>
    </div>
  </div>

  <!-- Carousel controls -->
  <div
    class="relative z-10 mx-auto w-full max-w-[var(--container-max)] px-[var(--section-padding-x)] pb-6"
  >
    <div class="flex items-center gap-3" data-hero-dots>
      {
        slides.map((_, i) => (
          <button
            type="button"
            data-dot
            aria-label={`Show image ${i + 1} of ${slides.length}`}
            aria-current={i === 0 ? "true" : "false"}
            class="hero-dot"
          />
        ))
      }
    </div>
  </div>

  <!-- Stat strip -->
  <div class="relative z-10 border-t border-border bg-bg/80">
    <div
      class="mx-auto max-w-[var(--container-max)] px-[var(--section-padding-x)]"
    >
      <div class="grid grid-cols-4 divide-x divide-border">
        {
          stats.map((stat) => (
            <div class="flex flex-col items-center py-6 px-1 gap-1 text-center">
              <span class="font-display font-semibold text-4xl text-[var(--color-accent)] leading-none">
                {stat.value}
              </span>
              <span class="font-body text-xs md:text-sm text-[var(--color-text-muted)]">
                {stat.label}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero-pattern {
    background-image: repeating-linear-gradient(
      45deg,
      var(--color-accent) 0,
      var(--color-accent) 1px,
      transparent 0,
      transparent 50%
    );
    background-size: 22px 22px;
  }

  .hero-glow {
    top: -15%;
    right: -5%;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 10%, transparent) 0%,
      transparent 70%
    );
  }

  .hero-overlay {
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--color-bg) 97%, transparent) 0%,
      color-mix(in srgb, var(--color-bg) 75%, transparent) 35%,
      color-mix(in srgb, var(--color-bg) 20%, transparent) 70%,
      color-mix(in srgb, var(--color-bg) 5%, transparent) 100%
    );
  }

  /* Below desktop the headline and lede sit higher up the photo, where the
     overlay above is nearly clear — "edge." fell to ~1.4:1 on bright frames.
     Carry the shade further up so the text stays readable on both slides. */
  @media (max-width: 1199px) {
    .hero-overlay {
      background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-bg) 97%, transparent) 0%,
        color-mix(in srgb, var(--color-bg) 82%, transparent) 45%,
        color-mix(in srgb, var(--color-bg) 60%, transparent) 80%,
        color-mix(in srgb, var(--color-bg) 45%, transparent) 100%
      );
    }
  }

  .hero-dot {
    position: relative;
    width: 32px;
    height: 3px;
    background: rgba(255, 255, 255, 0.28);
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      width 0.3s ease;
  }

  /* Invisible hit area: the visible bar is only 3px tall. */
  .hero-dot::before {
    content: "";
    position: absolute;
    inset: -20px -6px;
  }

  .hero-dot:hover {
    background: rgba(255, 255, 255, 0.55);
  }

  .hero-dot[aria-current="true"] {
    width: 48px;
    background: var(--color-accent);
  }

  .hero-dot:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .hero-carousel {
    touch-action: pan-y;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-carousel [data-slide] {
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  function initHeroCarousel(root: HTMLElement) {
    const slides = Array.from(
      root.querySelectorAll<HTMLImageElement>("[data-slide]"),
    );
    if (slides.length < 2) return;

    const section = root.closest("section");
    const dots = Array.from(
      section?.querySelectorAll<HTMLButtonElement>("[data-dot]") ?? [],
    );
    const interval = Number(root.dataset.interval ?? 5000);

    let current = 0;
    let timer: number | undefined;

    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        const active = i === current;
        slide.classList.toggle("opacity-100", active);
        slide.classList.toggle("opacity-0", !active);
        slide.setAttribute("aria-hidden", active ? "false" : "true");
      });
      dots.forEach((dot, i) =>
        dot.setAttribute("aria-current", i === current ? "true" : "false"),
      );
    };

    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    const start = () => {
      stop();
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      timer = window.setInterval(() => show(current + 1), interval);
    };

    const goTo = (next: number) => {
      show(next);
      start();
    };

    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));

    // Swipe / drag
    let startX = 0;
    let startY = 0;
    let tracking = false;

    const onDown = (x: number, y: number) => {
      startX = x;
      startY = y;
      tracking = true;
    };

    const onUp = (x: number, y: number) => {
      if (!tracking) return;
      tracking = false;
      const dx = x - startX;
      const dy = y - startY;
      if (Math.abs(dx) < 40 || Math.abs(dx) < Math.abs(dy)) return;
      goTo(current + (dx < 0 ? 1 : -1));
    };

    const swipeTarget = section ?? root;

    swipeTarget.addEventListener(
      "touchstart",
      (e) => {
        const t = (e as TouchEvent).changedTouches[0];
        onDown(t.clientX, t.clientY);
      },
      { passive: true },
    );

    swipeTarget.addEventListener(
      "touchend",
      (e) => {
        const t = (e as TouchEvent).changedTouches[0];
        onUp(t.clientX, t.clientY);
      },
      { passive: true },
    );

    swipeTarget.addEventListener("mousedown", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest("a, button")) return;
      onDown((e as MouseEvent).clientX, (e as MouseEvent).clientY);
    });

    swipeTarget.addEventListener("mouseup", (e) =>
      onUp((e as MouseEvent).clientX, (e as MouseEvent).clientY),
    );

    swipeTarget.addEventListener("mouseleave", () => {
      tracking = false;
    });

    // Pause when off-screen or tab hidden
    document.addEventListener("visibilitychange", () =>
      document.hidden ? stop() : start(),
    );

    if ("IntersectionObserver" in window && section) {
      new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? start() : stop()),
        { threshold: 0.1 },
      ).observe(section);
    } else {
      start();
    }
  }

  document
    .querySelectorAll<HTMLElement>("[data-hero-carousel]")
    .forEach(initHeroCarousel);
</script>
