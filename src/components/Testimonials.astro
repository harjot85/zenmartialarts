---
import testimonialsData from "../content/testimonials.json";

type Testimonial = {
  quote: string;
  name: string;
  initials?: string;
};

// Derive initials from the name when the CMS entry leaves the field blank.
function initialsFor(name: string): string {
  return name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0]!.toUpperCase())
    .join("");
}

// Split a quote into paragraphs on blank lines so multi-paragraph reviews
// render with real spacing instead of HTML collapsing the line breaks.
function toParagraphs(quote: string): string[] {
  return quote
    .split(/\n\s*\n/)
    .map((para) => para.trim())
    .filter(Boolean);
}

const testimonials = (testimonialsData.testimonials as Testimonial[]).map(
  (t) => ({
    ...t,
    initials: t.initials?.trim() || initialsFor(t.name),
    paragraphs: toParagraphs(t.quote),
  }),
);
---

<section class="testimonials-section">
  <div class="testimonials-inner">
    <div class="testimonials-header">
      <span class="testimonials-label">Real members</span>
      <h2 class="testimonials-title">WHAT THEY SAY</h2>
    </div>

    <ul class="testimonials-list" role="list">
      {
        testimonials.map((t) => (
          <li class="testimonial-card">
            <div class="testimonial-stars" aria-label="5 out of 5 stars">
              ★★★★★
            </div>
            <blockquote class="testimonial-quote">
              {t.paragraphs.map((para) => (
                <p class="testimonial-para">{para}</p>
              ))}
            </blockquote>
            <div class="testimonial-author">
              <div class="testimonial-avatar" aria-hidden="true">
                {t.initials}
              </div>
              <div class="testimonial-author-info">
                <span class="testimonial-name">{t.name}</span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .testimonials-section {
    background: #0d0d0d;
    padding: 48px 24px;
  }

  .testimonials-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .testimonials-header {
    margin-bottom: 32px;
  }

  .testimonials-label {
    display: block;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .testimonials-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: 44px;
    color: #f5f5f5;
    margin: 0;
    line-height: 1;
  }

  .testimonials-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .testimonial-card {
    background: #111;
    border-top: 2px solid var(--color-accent);
    padding: 24px;
  }

  .testimonial-stars {
    color: var(--color-accent);
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .testimonial-quote {
    margin: 0 0 16px;
  }

  .testimonial-para {
    font-family: "Barlow", sans-serif;
    font-size: 15px;
    color: #ccc;
    line-height: 1.7;
    font-style: italic;
    margin: 0 0 12px;
  }

  .testimonial-para:last-child {
    margin-bottom: 0;
  }

  .testimonial-author {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonial-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Bebas Neue", sans-serif;
    font-size: 16px;
    color: #0a0a0a;
    flex-shrink: 0;
  }

  .testimonial-author-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .testimonial-name {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    color: #f5f5f5;
    line-height: 1.2;
  }
</style>
