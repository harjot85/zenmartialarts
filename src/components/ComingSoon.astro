---
interface Props {
  headline: string;
  message: string;
}
const { headline, message } = Astro.props;
---

<section class="cs-section">
  <div class="cs-inner">
    <span class="cs-label">Under construction</span>
    <h1 class="cs-headline">{headline}</h1>
    <p class="cs-message">{message}</p>
    <div class="cs-actions">
      <a href="/#trial" class="cs-btn cs-btn--primary">Book a free trial</a>
      <a href="/" class="cs-btn cs-btn--ghost">Back to home</a>
    </div>
  </div>
</section>

<style>
  .cs-section {
    background: var(--color-bg);
    min-height: calc(100dvh - 80px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--section-padding-block) var(--container-padding-x);
  }

  .cs-inner {
    max-width: 560px;
    text-align: center;
  }

  .cs-label {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 6px 14px;
    margin-bottom: 28px;
  }

  .cs-headline {
    color: var(--color-text);
    margin: 0 0 20px;
  }

  .cs-message {
    font-family: var(--font-body);
    font-size: 17px;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0 0 40px;
  }

  .cs-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
  }

  @media (min-width: 480px) {
    .cs-actions {
      flex-direction: row;
      justify-content: center;
    }
  }

  .cs-btn {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    padding: 14px 32px;
    text-decoration: none;
    border-radius: 0;
    transition: opacity 0.15s;
  }

  .cs-btn:hover {
    opacity: 0.85;
  }

  .cs-btn--primary {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .cs-btn--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .cs-btn--ghost:hover {
    border-color: var(--color-text-muted);
    opacity: 1;
  }
</style>
