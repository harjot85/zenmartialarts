---
import scheduleData from "../content/schedule.json";

// Maps each specific schedule class name → its broad discipline label.
// Unknown names fall through to their raw class name.
const disciplineMap: Record<string, string> = {
  "No Gi BJJ Fundamentals": "No Gi BJJ",
  "No Gi BJJ All Levels": "No Gi BJJ",
  "No Gi BJJ": "No Gi BJJ",
  "BJJ No Gi Kids — Ages 4–8": "No Gi BJJ",
  "BJJ No Gi Kids — Ages 9–13": "No Gi BJJ",
  "BJJ No Gi Kids — Ages 8+": "No Gi BJJ",
  "Gi BJJ All Levels": "Gi BJJ",
  "Muay Thai": "Muay Thai",
  "Adult Boxing": "Boxing",
  "Wrestling — Adults & Kids 8+": "Wrestling",
  "Kids MMA — Ages 4–8": "Kids MMA",
  "Kids MMA — Ages 9–13": "Kids MMA",
  "Ladies Self-Defence": "Ladies Self-Defence",
  "Sunday Open Mat — All Levels": "Open Mat",
};

const dayOrder: Record<string, number> = {
  Mon: 0,
  Tue: 1,
  Wed: 2,
  Thu: 3,
  Fri: 4,
  Sat: 5,
  Sun: 6,
};

type DisciplineInfo = {
  days: Set<string>;
  hasKids: boolean;
  hasAdults: boolean;
};

// Some classes serve multiple audiences even when the schedule.json category
// is single-valued (e.g. Wrestling is Adults & Kids 8+ but stored as "adults").
const audienceOverride: Record<
  string,
  { hasKids?: boolean; hasAdults?: boolean }
> = {
  Wrestling: { hasKids: true, hasAdults: true },
};

const disciplineData = new Map<string, DisciplineInfo>();
for (const day of scheduleData.days) {
  for (const cls of day.classes) {
    const label = disciplineMap[cls.name] ?? cls.name;
    if (!disciplineData.has(label)) {
      disciplineData.set(label, {
        days: new Set(),
        hasKids: false,
        hasAdults: false,
      });
    }
    const info = disciplineData.get(label)!;
    info.days.add(day.shortDay);
    if (cls.category === "kids") info.hasKids = true;
    else info.hasAdults = true;
  }
}

for (const [label, overrides] of Object.entries(audienceOverride)) {
  const info = disciplineData.get(label);
  if (!info) continue;
  if (overrides.hasKids !== undefined) info.hasKids = overrides.hasKids;
  if (overrides.hasAdults !== undefined) info.hasAdults = overrides.hasAdults;
}

// Disciplines that appear on the schedule but should not be listed as classes
// on the main page (e.g. open mat is a drop-in session, not a class).
const excludeFromList = new Set(["Open Mat"]);

const classes = Array.from(disciplineData.entries())
  .filter(([name]) => !excludeFromList.has(name))
  .map(([name, info]) => ({
    name,
    schedule: Array.from(info.days)
      .sort((a, b) => dayOrder[a] - dayOrder[b])
      .join(" / "),
    hasKids: info.hasKids,
    hasAdults: info.hasAdults,
  }));
---

<section class="classes-section">
  <div class="classes-inner">
    <div class="classes-header">
      <span class="classes-label">What we teach</span>
      <h2 class="classes-title">OUR CLASSES</h2>
    </div>

    <ul class="classes-list" role="list">
      {
        classes.map((cls, i) => (
          <li class:list={["class-card", { "class-card--active": i === 0 }]}>
            <div class="class-card__left">
              <span class="class-card__name">{cls.name}</span>
              <span class="class-card__schedule">{cls.schedule}</span>
            </div>
            <div class="class-card__right">
              <span
                class:list={[
                  "class-badge",
                  { "class-badge--muted": !cls.hasKids },
                ]}
              >
                {cls.hasKids && cls.hasAdults
                  ? "Adults & Kids"
                  : cls.hasKids
                    ? "Kids"
                    : "Adults"}
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .classes-section {
    background: #0a0a0a;
    padding: 48px 24px;
  }

  .classes-inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .classes-header {
    margin-bottom: 32px;
  }

  .classes-label {
    display: block;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--color-accent);
    margin-bottom: 8px;
  }

  .classes-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: 44px;
    color: #f5f5f5;
    margin: 0;
    line-height: 1;
  }

  .classes-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .class-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #111;
    border-left: 3px solid transparent;
    padding: 20px 20px;
  }

  .class-card--active {
    background: #161616;
    border-left-color: var(--color-accent);
  }

  .class-card__left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .class-card__name {
    font-family: "Barlow Condensed", sans-serif;
    font-size: 18px;
    font-weight: 700;
    text-transform: uppercase;
    color: #f5f5f5;
    line-height: 1.2;
  }

  .class-card__schedule {
    font-family: "Barlow", sans-serif;
    font-size: 13px;
    color: var(--color-secondary);
    line-height: 1.4;
  }

  .class-card__right {
    flex-shrink: 0;
    margin-left: 16px;
  }

  .class-badge {
    display: inline-block;
    background: var(--color-accent);
    color: #0a0a0a;
    font-family: "Barlow Condensed", sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 6px 12px;
    border: 1px solid var(--color-accent);
    border-radius: 0;
  }

  .class-badge--muted {
    background: transparent;
    color: var(--color-secondary);
    border-color: #333;
  }
</style>
