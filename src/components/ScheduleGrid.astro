---
import {
  notes,
  dayIndexMap,
  formatRange,
  daysFor,
  bandRows,
  bandRange,
  disciplineOf,
  levelOf,
} from "../lib/schedule";

const tables = (["adults", "kids"] as const).map((audience) => {
  // Kids run Mon–Sat only, so drop empty day columns from that table.
  const days = daysFor(audience).filter(
    (d) => audience === "adults" || d.classes.length > 0,
  );
  return {
    audience,
    title: audience === "adults" ? "Adults" : "Kids",
    blurb:
      audience === "adults"
        ? "Drop into any class marked All Levels or Fundamentals."
        : "Ages 4–8 and Ages 9–13 train separately. Blocks marked All ages welcome parents and older kids on the same mat.",
    days,
    rows: bandRows(days),
  };
});

const mobileDays = daysFor("adults");
---

<section class="sg-section section">
  <div class="wrap">
    <!-- ═══════════════════════════════════════════
       DESKTOP TABLES (768px+) — Adults, then Kids
  ═══════════════════════════════════════════ -->
    <div class="desktop-grid">
      {
        tables.map((table) => (
          <div class="table-block">
            <div class="table-head">
              <h2 class="table-title">{table.title}</h2>
              <p class="table-blurb">{table.blurb}</p>
            </div>
            <div class="table-scroll">
              <table class="schedule-table">
                <caption class="sr-only">
                  {table.title} class schedule, grouped by time of day
                </caption>
                <thead>
                  <tr>
                    <th class="th-band-head" scope="col">
                      Block
                    </th>
                    {table.days.map((day) => (
                      <th
                        class="schedule-th"
                        scope="col"
                        data-day={dayIndexMap[day.day]}
                      >
                        {day.shortDay}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {table.rows.map((row) => (
                    <tr>
                      <th class="td-band" scope="row">
                        <span class="band-label">{row.label}</span>
                        <span class="band-span">{bandRange(row)}</span>
                      </th>
                      {row.perDay.map((classes, i) => (
                        <td
                          class:list={[
                            "grid-cell",
                            { "grid-cell--filled": classes.length > 0 },
                          ]}
                          data-day={dayIndexMap[table.days[i].day]}
                        >
                          {classes.map((cls, n) => (
                            <div
                              class:list={[
                                "cell-entry",
                                { "cell-entry--stacked": n > 0 },
                              ]}
                              data-discipline={disciplineOf(cls)}
                              data-level={levelOf(cls)}
                            >
                              <span class="cell-time">
                                {formatRange(cls.start, cls.end)}
                              </span>
                              <span class="cell-name">{cls.name}</span>
                              {cls.detail && (
                                <span class="cell-detail">{cls.detail}</span>
                              )}
                              {cls.category === "both" && (
                                <span class="cell-tag">All ages</span>
                              )}
                            </div>
                          ))}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        ))
      }
    </div>

    <!-- ═══════════════════════════════════════════
       MOBILE TABS (under 768px) — one day, grouped by audience
  ═══════════════════════════════════════════ -->
    <div class="mobile-schedule">
      <div class="tab-strip" role="tablist" aria-label="Day selector">
        {
          mobileDays.map((day) => (
            <button
              class="tab-btn"
              role="tab"
              type="button"
              data-day={dayIndexMap[day.day]}
              aria-selected="false"
            >
              {day.shortDay}
            </button>
          ))
        }
      </div>

      <div class="tab-content">
        {
          mobileDays.map((day) => {
            const groups = tables
              .map((t) => ({
                title: t.title,
                classes: t.days.find((d) => d.day === day.day)?.classes ?? [],
              }))
              .filter((g) => g.classes.length > 0);
            return (
              <div
                class="mobile-panel"
                role="tabpanel"
                data-day={dayIndexMap[day.day]}
              >
                {groups.length > 0 ? (
                  groups.map((g) => (
                    <div class="m-group">
                      <h3 class="m-group-title">{g.title}</h3>
                      <div class="m-cards">
                        {g.classes.map((cls) => (
                          <div
                            class="m-card"
                            data-discipline={disciplineOf(cls)}
                            data-level={levelOf(cls)}
                          >
                            <div class="m-time">
                              {formatRange(cls.start, cls.end)}
                            </div>
                            <div class="m-body">
                              <div class="m-name">{cls.name}</div>
                              {cls.detail && (
                                <div class="m-detail">{cls.detail}</div>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))
                ) : (
                  <div class="m-closed">
                    <p>Closed today. See you tomorrow!</p>
                    <p>
                      Contact us for private training:&nbsp;
                      <a href="tel:+17788356590" class="m-phone">
                        778-835-6590
                      </a>
                    </p>
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </div>

    <!-- ═══════════════════════════════════════════
       NOTES
  ═══════════════════════════════════════════ -->
    <div class="notes-block">
      <span class="notes-label">Notes</span>
      <ul class="notes-list">
        {notes.map((note) => <li class="notes-item">{note}</li>)}
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    var todayGetDay = new Date().getDay(); // 0=Sun, 1=Mon … 6=Sat
    var daySel = '[data-day="' + todayGetDay + '"]';

    // ── DESKTOP: highlight today's column in every table ──
    document.querySelectorAll(".schedule-th" + daySel).forEach(function (th) {
      th.classList.add("th-today");
    });
    document.querySelectorAll(".grid-cell" + daySel).forEach(function (td) {
      td.classList.add("cell-today");
    });

    // ── MOBILE: tab switching ──
    var tabBtns = document.querySelectorAll(".tab-btn");
    var mobilePanels = document.querySelectorAll(".mobile-panel");

    function activateTab(dayVal) {
      var dayStr = String(dayVal);
      tabBtns.forEach(function (btn) {
        var isActive = btn.getAttribute("data-day") === dayStr;
        btn.classList.toggle("tab-btn--active", isActive);
        btn.setAttribute("aria-selected", isActive ? "true" : "false");
        // The strip scrolls sideways with a hidden scrollbar; on narrow
        // phones Sat/Sun start off-screen. Keep the active day in view
        // (scrolls only the strip, never the page).
        var strip = btn.parentElement;
        if (isActive && strip) {
          var left = btn.offsetLeft - strip.offsetLeft;
          if (left < strip.scrollLeft) {
            strip.scrollLeft = left;
          } else if (
            left + btn.offsetWidth >
            strip.scrollLeft + strip.clientWidth
          ) {
            strip.scrollLeft = left + btn.offsetWidth - strip.clientWidth;
          }
        }
      });
      mobilePanels.forEach(function (panel) {
        panel.classList.toggle(
          "mobile-panel--active",
          panel.getAttribute("data-day") === dayStr,
        );
      });
    }

    tabBtns.forEach(function (btn) {
      btn.addEventListener("click", function () {
        activateTab(btn.getAttribute("data-day"));
      });
    });

    activateTab(todayGetDay);
  });
</script>

<style>
  /* ─── Section wrapper ─── */
  .sg-section {
    background: var(--color-bg);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ─── Discipline colour, and the brighter shade for advanced ─── */
  [data-discipline="bjj"] {
    --std: var(--discipline-bjj);
    --adv: var(--discipline-bjj-adv);
  }
  [data-discipline="wrestling"] {
    --std: var(--discipline-wrestling);
    --adv: var(--discipline-wrestling-adv);
  }
  [data-discipline="striking"] {
    --std: var(--discipline-striking);
    --adv: var(--discipline-striking-adv);
  }
  [data-discipline="boxing"] {
    --std: var(--discipline-boxing);
    --adv: var(--discipline-boxing-adv);
  }
  [data-discipline="mma"] {
    --std: var(--discipline-mma);
    --adv: var(--discipline-mma-adv);
  }
  [data-discipline="specialty"] {
    --std: var(--discipline-specialty);
    --adv: var(--discipline-specialty-adv);
  }
  [data-discipline="openmat"] {
    --std: var(--discipline-openmat);
    --adv: var(--discipline-openmat-adv);
  }
  [data-discipline] {
    --hue: var(--std);
  }
  [data-discipline][data-level="advanced"] {
    --hue: var(--adv);
  }

  /* ─── Show/hide desktop vs mobile ─── */
  .desktop-grid {
    display: none;
  }
  .mobile-schedule {
    display: block;
  }

  @media (min-width: 768px) {
    .desktop-grid {
      display: block;
    }
    .mobile-schedule {
      display: none;
    }
  }

  /* ════════════════════════════════════
     DESKTOP TABLES
  ════════════════════════════════════ */
  .table-block + .table-block {
    margin-top: 56px;
  }

  .table-head {
    margin: 0 0 16px;
  }

  .table-title {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 6px;
    line-height: 1.08;
  }

  .table-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .table-blurb {
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .schedule-table {
    width: 100%;
    min-width: 960px;
    border-collapse: collapse;
    table-layout: fixed;
  }

  /* Header row */
  .th-band-head,
  .schedule-th {
    background: var(--color-surface);
    border-bottom: 2px solid var(--color-accent);
    border-right: 1px solid var(--color-border);
    padding: 13px 10px;
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--color-text);
    text-align: center;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .th-band-head {
    position: sticky;
    left: 0;
    z-index: 3;
    width: 152px;
    min-width: 152px;
    color: var(--color-secondary);
  }

  /* Today's column header (added by JS) */
  .th-today {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  /* Band label cells */
  .td-band {
    position: sticky;
    left: 0;
    z-index: 2;
    background: var(--color-bg);
    width: 152px;
    min-width: 152px;
    padding: 14px 12px;
    text-align: left;
    vertical-align: top;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    font-weight: 400;
  }

  .band-label {
    display: block;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.15;
  }

  .band-span {
    display: block;
    font-family: var(--font-body);
    font-size: 12.5px;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Body cells */
  .grid-cell {
    background: var(--color-bg);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 0;
    vertical-align: top;
  }

  .grid-cell--filled {
    background: var(--color-surface);
  }

  .cell-today.grid-cell--filled {
    background: color-mix(
      in srgb,
      var(--color-accent) 7%,
      var(--color-surface)
    );
  }

  .cell-entry {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 11px 11px;
    border-left: 3px solid var(--hue);
  }

  .cell-entry--stacked {
    border-top: 1px solid var(--color-border);
  }

  .cell-time {
    font-family: var(--font-display);
    font-size: 14.5px;
    font-weight: 500;
    color: var(--color-accent);
    line-height: 1.25;
    font-variant-numeric: tabular-nums;
  }

  .cell-name {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.25;
  }

  .cell-detail {
    font-family: var(--font-body);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .cell-tag {
    align-self: flex-start;
    margin-top: 4px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    color: var(--hue);
    border: 1px solid var(--hue);
    padding: 1px 7px;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* ════════════════════════════════════
     MOBILE TABS
  ════════════════════════════════════ */
  .tab-strip {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: 6px;
    padding-bottom: 16px;
    scrollbar-width: none;
  }

  .tab-strip::-webkit-scrollbar {
    display: none;
  }

  .tab-btn {
    flex-shrink: 0;
    min-height: 44px; /* tap target */
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    padding: 9px 15px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    cursor: pointer;
    line-height: 1;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .tab-btn--active {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  .tab-content {
    padding-bottom: 8px;
  }

  .mobile-panel {
    display: none;
  }

  .mobile-panel--active {
    display: block;
  }

  .m-group + .m-group {
    margin-top: 24px;
  }

  .m-group-title {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0 0 10px;
    line-height: 1.08;
  }

  .m-group-title::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .m-cards {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .m-card {
    background: var(--color-surface);
    border-left: 3px solid var(--hue);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    border-radius: 0;
  }

  .m-time {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    color: var(--color-accent);
    min-width: 132px;
    flex-shrink: 0;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .m-body {
    flex: 1;
    min-width: 0;
  }

  .m-name {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
  }

  .m-detail {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-text-muted);
    line-height: 1.3;
  }

  .m-closed {
    text-align: center;
    padding: 40px 0;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .m-closed p {
    margin: 0 auto;
  }

  .m-phone {
    color: var(--color-accent);
    text-decoration: none;
  }

  /* ════════════════════════════════════
     NOTES
  ════════════════════════════════════ */
  .notes-block {
    background: var(--color-surface);
    padding: 24px;
    margin: 40px 0 0;
  }

  .notes-label {
    display: block;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 10px;
  }

  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .notes-item {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
